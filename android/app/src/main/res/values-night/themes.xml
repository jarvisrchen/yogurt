<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Yogurt" parent="android:Theme.Material.NoActionBar">
        <!-- The WebView reports prefers-color-scheme: dark only when this is set, since the parent theme leaves it out. -->
        <item name="android:isLightTheme" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorControlActivated">@color/blue</item>
        <item name="android:textColorHighlight">@color/blsoft</item>
    </style>
</resources>
